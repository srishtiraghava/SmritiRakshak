# ── SmritiRakshak Environment Configuration ──
# Copy this file to .env and fill in values as needed.

# Maximum number of characters allowed in a single memory entry.
MAX_CONTENT_LENGTH=10000

# ── Risk‑score thresholds (inclusive lower bounds) ──
# Entries scoring below THRESHOLD_FLAG are ALLOWED.
# Entries scoring at or above THRESHOLD_BLOCK are BLOCKED.
THRESHOLD_FLAG=30
THRESHOLD_QUARANTINE=50
THRESHOLD_BLOCK=80

# Application metadata (optional overrides)
APP_NAME=SmritiRakshak
APP_VERSION=0.1.0
